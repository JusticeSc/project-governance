{
  "extends": "./tsconfig.node.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rewriteRelativeImportExtensions": false
  },
  "include": [
    "apps/*/tests/**/*.ts",
    "apps/*/tests/**/*.tsx",
    "packages/*/*/tests/**/*.ts",
    "packages/*/*/tests/**/*.tsx",
    "scripts/**/*.ts",
    "*.config.ts",
    "vitest.shared.ts"
  ],
  "exclude": [
    "scripts/fixtures/**"
  ],
  "references": []
}
