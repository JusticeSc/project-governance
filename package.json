{
  "name": "project-governance",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Project governance rules, an Agent Skill, and executable repository checks.",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*/*"
  ],
  "scripts": {
    "governance": "node apps/cli/bin/governance.mjs",
    "install-skill": "node apps/cli/bin/governance.mjs install",
    "test": "npm run test --workspaces && node --test tests/*.test.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:structure": "node scripts/verify-structure.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "install-template": "node scripts/install-template.mjs",
    "export-template": "node scripts/export-template.mjs",
    "generate:template-payload": "node scripts/generate-template-payload.mjs",
    "check:template": "node scripts/check-template.mjs",
    "check": "node apps/cli/bin/governance.mjs check . --policy governance-checks.json",
    "smoke": "node scripts/smoke.mjs"
  },
  "files": [
    "package.json",
    "LICENSE",
    "README.md",
    "README.zh.md",
    "AGENTS.md",
    ".gitattributes",
    "CHANGELOG.md",
    "CHANGELOG.zh.md",
    "CHANGELOG.i18n.yaml",
    "README.i18n.yaml",
    "references/",
    "docs/",
    "apps/",
    "packages/",
    "scripts/",
    "tests/",
    "skills/project-governance/",
    ".doc-gates/",
    ".github/workflows/check.yml",
    "governance-checks.json",
    "npm-shrinkwrap.json",
    "SOURCE-LICENSE.txt",
    "templates/node-typescript/*.json",
    "templates/node-typescript/*.yaml",
    "templates/node-typescript/*.yml",
    "templates/node-typescript/*.md",
    "templates/node-typescript/*.ts",
    "templates/node-typescript/Makefile",
    "templates/node-typescript/LICENSE",
    "templates/node-typescript/SOURCE-LICENSE.txt",
    "templates/node-typescript/gitignore",
    "templates/node-typescript/.editorconfig",
    "templates/node-typescript/.gitattributes",
    "templates/node-typescript/.jscpd.json",
    "templates/node-typescript/.oxlintrc.json",
    "templates/node-typescript/.oxlintrc.staged.json",
    "templates/node-typescript/.rgignore",
    "templates/node-typescript/.agents/",
    "templates/node-typescript/.github/**/{*.json,*.md,*.mjs,*.py,*.txt,*.yaml,*.yml,gitignore}",
    "templates/node-typescript/docs/",
    "templates/node-typescript/packages/*.{json,md,ts,yaml,yml}",
    "templates/node-typescript/scripts/"
  ],
  "devDependencies": {
    "@project-governance/distribution": "*",
    "typescript": "6.0.3"
  }
}
